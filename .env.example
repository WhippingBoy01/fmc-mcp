# Cisco FMC connection
FMC_HOST=https://fmc.example.local
FMC_USERNAME=apiuser
FMC_PASSWORD=changeme
FMC_DOMAIN_UUID=
FMC_VERIFY_SSL=true
# Optional path to a CA bundle for private/self-signed FMC certificates
FMC_CA_BUNDLE=

# Safety: mutating tools (create/update/delete) require this to be true.
FMC_ALLOW_WRITES=false

# MCP server transport
# http = Streamable HTTP (recommended for remote/shared use; serves /mcp)
# stdio = local subprocess integration
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000

LOG_LEVEL=INFO
